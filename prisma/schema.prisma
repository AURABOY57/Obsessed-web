// Prisma schema for obsessed.cba
// Multi-platform e-commerce & admin dashboard

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?     @db.Text
  category    String?     @default("General")
  subCategory String?
  price         Decimal     @db.Decimal(10, 2)
  originalPrice Decimal?    @db.Decimal(10, 2) // Precio original tachado si hay oferta activa
  offerPrice    Decimal?    @db.Decimal(10, 2) // Precio promocional
  offerEndsAt   DateTime?   // Fecha y hora de vencimiento de la oferta
  offerLabel    String?     // Etiqueta ej: "20% OFF", "HOT SALE", "FIN DE SEMANA"
  costPrice     Decimal?    @db.Decimal(10, 2)
  stock         Int         @default(0)
  variants      Json?       // Lista de variantes ej: [{"name": "Virola", "options": ["Lisa", "Cincelada"]}]
  imageUrl      String      // Cloudinary secure URL
  images        String[]    @default([]) // Galería de imágenes adicionales
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  orderItems  OrderItem[]

  @@index([slug])
  @@index([isActive])
  @@index([offerEndsAt])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerName    String
  customerPhone   String
  customerEmail   String?
  customerAddress String?
  shippingCarrier String?       // Ej: Correo Argentino, Andreani, Cadete
  trackingNumber  String?       // Código de seguimiento de envío
  status          OrderStatus   @default(PENDING)
  total           Decimal       @db.Decimal(10, 2)
  paymentMethod   String?       @default("WHATSAPP_COORDINATE")
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           OrderItem[]

  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantName String?  // Ej: "Virola Cincelada - Cuero Negro"
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}
